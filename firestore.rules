rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profiles
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Instances
    match /instances/{instanceId} {
      allow read, create: if isSignedIn();
      allow update: if isSignedIn(); // In a shared West, we allow updates (e.g. for archiving)

      match /characters/{charId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
        allow update: if isSignedIn() && (
          resource.data.ownerUid == request.auth.uid || 
          !resource.data.keys().hasAll(['ownerUid']) // Legacy support
        );
        allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      }

      match /messages/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        // Messages are usually immutable in this app
      }
    }
  }
}
